# Copy to backend/.env if you want. Real values stay out of git.
# The process reads the environment; a present .env fills only unset keys.

MEOWMAP_MQTT_HOST=127.0.0.1
MEOWMAP_MQTT_PORT=1883
MEOWMAP_MQTT_USER=
MEOWMAP_MQTT_PASSWORD=
MEOWMAP_MQTT_TOPIC_MEOW=meowmap/events/meow
MEOWMAP_MQTT_TOPIC_VOTE=meowmap/events/vote
MEOWMAP_SQLITE_PATH=meowmap.db
